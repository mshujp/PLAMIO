{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure PLAMIO (Local)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "local"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build PLAMIO",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "local-build"
      ],
      "dependsOn": "Configure PLAMIO (Local)",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build & Deploy PLAMIO UF2",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "local-deploy"
      ],
      "dependsOn": "Configure PLAMIO (Local)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
